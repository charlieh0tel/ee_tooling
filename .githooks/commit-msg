#!/bin/sh
# Refuse a commit that credits an AI assistant: this repository's commits
# carry no such trailer or footer, and no such author or committer
# (AGENTS.md).
#
# As the hook, Git passes the message file as $1; the commit's author
# and committer come from `git var`.  CI checks the whole history with
# `--messages FILE`, every commit's message, and `--identities FILE`,
# every commit's author and committer, one `Name <address>` a line as
# `git var` gives them.  scripts/test-commit-msg.sh tests both.
#
# A message is checked whole, its lines starting with # too: git keeps
# them in a message given with -m or -F, and a commit in the history
# has them as committed.  As the hook, where git opened an editor (it
# sets GIT_EDITOR to : where it did not), the scissors line git writes
# above `git commit -v`'s diff and everything after it, which git
# drops, are not checked.  A trailer line, an address, or the footer,
# rather than any mention of them, so a message may describe this
# check.
MESSAGE_PATTERN='^[[:space:]]*(co-authored-by|claude-session):|@anthropic\.com|claude\.ai/code|generated with \[?claude'
# The one co-author trailer that passes: Dependabot's, which GitHub adds
# to the squash merge of a Dependabot pull request.  The whole line and
# nothing else, so it cannot carry anything the pattern above refuses.
DEPENDABOT_TRAILER='^[[:space:]]*co-authored-by:[[:space:]]*dependabot\[bot\][[:space:]]*<[0-9]+\+dependabot\[bot\]@users\.noreply\.github\.com>[[:space:]]*$'
# A bot's identity, not a person's: an address at anthropic.com or a
# subdomain of it; a name that is Claude alone, Claude and a product
# word (Claude Code, Claude Bot) or claude[bot]; a name naming
# Anthropic.  A person named Claude passes.
IDENTITY_PATTERN='<[^>]*@([^>@]*\.)?anthropic\.com>|^[[:space:]]*claude([[:space:]]+(code|bot|assistant|agent|ai)([[:space:]][^<]*)?|\[bot\])?[[:space:]]*<|^[^<]*anthropic[^<]*<'
# Git's scissors line, after the comment character (core.commentChar).
SCISSORS=' ------------------------ >8 ------------------------$'

# check_message FILE: refuse the message in FILE.
check_message() {
    if grep -viE "$DEPENDABOT_TRAILER" "$1" | grep -qiE "$MESSAGE_PATTERN"; then
        echo "commit refused: the message credits an AI assistant, which this repository's commits never do (AGENTS.md)" >&2
        exit 1
    fi
}

check_identities() {
    if printf '%s\n' "$1" | grep -qiE "$IDENTITY_PATTERN"; then
        echo "commit refused: its author or committer is an AI assistant, which this repository's commits never are (AGENTS.md)" >&2
        exit 1
    fi
}

case "$1" in
--messages)
    check_message "$2"
    ;;
--identities)
    check_identities "$(cat "$2")"
    ;;
*)
    message="$1"
    if [ "${GIT_EDITOR-}" != ":" ]; then
        message=$(mktemp) || exit 1
        trap 'rm -f "$message"' EXIT
        sed "/^[^ ]\{1,\}$SCISSORS/,\$d" "$1" >"$message" || exit 1
    fi
    check_message "$message"
    identities=$(git var GIT_AUTHOR_IDENT && git var GIT_COMMITTER_IDENT) || exit 1
    check_identities "$identities"
    ;;
esac
