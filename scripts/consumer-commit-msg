#!/bin/sh
# A board repository's .githooks/commit-msg: runs ee_tooling's
# commit-msg hook from the submodule (ee_tooling's docs/adopting.md).
# Git runs a hook from the top of the work tree, so the path is from
# there.  Until `git submodule update --init` the hook is missing, and
# the commit is refused rather than left unchecked.
EE_TOOLING=hardware/ee_tooling
HOOK=$EE_TOOLING/.githooks/commit-msg
if [ ! -f "$HOOK" ]; then
    echo "commit refused: $HOOK is missing; run git submodule update --init" >&2
    exit 1
fi
exec sh "$HOOK" "$@"
