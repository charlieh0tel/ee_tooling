#!/bin/sh
# Runs ee_tooling's commit-msg hook from its submodule.  Written by
# @EE_TOOLING@/adopt (ee_tooling's docs/adopting.md): rerun it rather
# than editing this file.  Git runs a hook from the top of the work tree, so
# the path is from there.  Until `git submodule update --init` the hook
# is missing, and the commit is refused rather than left unchecked.
HOOK=@EE_TOOLING@/.githooks/commit-msg
if [ ! -f "$HOOK" ]; then
    echo "commit refused: $HOOK is missing; run git submodule update --init" >&2
    exit 1
fi
exec sh "$HOOK" "$@"
